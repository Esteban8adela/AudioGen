# =============================================================================
# AudioGen — environment variables (copy to .env.local and fill in values)
# Never commit real secrets. Validated at runtime via src/lib/env.ts
# =============================================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase ---
# Project URL (Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Anon / public key (safe for browser; RLS-enforced)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Service role key (server-only — NEVER expose to the client)
# Used carefully in Route Handlers for upload/generation paths.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Redis (job queue — Paso 6 worker) ---
REDIS_URL=redis://localhost:6379

# --- Cloudflare R2 (audio/cover storage) ---
R2_ACCOUNT_ID=your-r2-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=audiogen
R2_PUBLIC_BASE_URL=https://your-cdn.example.com

# --- Stripe (billing — later pasos) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_POWER=price_...
STRIPE_PRICE_CREDITS=price_...

# --- Logging ---
LOG_LEVEL=info
